PORT=3000

# Google Cloud Vision API anahtariniz.
# Alma adimlari README.md icinde "Google Vision API Anahtari Alma" bolumunde anlatilmistir.
GOOGLE_VISION_API_KEY=

# (Opsiyonel) Veritabani ve fis fotograflarinin tutulacagi klasor.
# Render'da kalici disk kullaniyorsaniz mount noktasini buraya yazin (orn. /var/data).
# Bos birakilirsa projenin kendi data/ klasoru kullanilir.
DATA_DIR=

# (Opsiyonel) Regex ile ayiklama basarisiz/eksik kaldiginda (tarih, firma,
# toplam, KDV, fis no, odeme yontemi gibi temel alanlardan biri bulunamazsa)
# devreye giren yedek yapay zeka modeli icin Anthropic API anahtari.
# https://console.anthropic.com/settings/keys adresinden alinabilir.
# Bos birakilirsa yedek katman devre disi kalir, sistem sadece regex ile calisir.
ANTHROPIC_API_KEY=
